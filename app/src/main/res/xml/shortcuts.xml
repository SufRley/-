<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面长按图标 → 快捷方式（AC-84）。这是 manifest 级配置资源，不是 XML 布局。 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="new_expense"
        android:shortcutLongLabel="@string/shortcut_new_expense_long"
        android:shortcutShortLabel="@string/shortcut_new_expense_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.xxjz.ledger.MainActivity"
            android:targetPackage="com.xxjz.ledger">
            <extra
                android:name="com.xxjz.ledger.extra.SHORTCUT"
                android:value="new_expense" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="open_report"
        android:shortcutLongLabel="@string/shortcut_report_long"
        android:shortcutShortLabel="@string/shortcut_report_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.xxjz.ledger.MainActivity"
            android:targetPackage="com.xxjz.ledger">
            <extra
                android:name="com.xxjz.ledger.extra.SHORTCUT"
                android:value="open_report" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="open_search"
        android:shortcutLongLabel="@string/shortcut_search_long"
        android:shortcutShortLabel="@string/shortcut_search_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.xxjz.ledger.MainActivity"
            android:targetPackage="com.xxjz.ledger">
            <extra
                android:name="com.xxjz.ledger.extra.SHORTCUT"
                android:value="open_search" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
